# Free token from https://aqicn.org/data-platform/token
# Copy this file to .env and paste your token. Leave it empty to use sample data.
EXPO_PUBLIC_WAQI_TOKEN=

# Address of the deployed alerts server (see server/README.md), e.g. https://jerebu-alerts.<you>.workers.dev
# Leave empty to keep alerts in-app only.
EXPO_PUBLIC_ALERTS_URL=
